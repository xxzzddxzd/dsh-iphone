{
  "name": "dsh-openai-images-api",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./lib/client.js"
  },
  "scripts": {
    "test": "vitest run",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && vitest run && tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "5.9.3",
    "tsdown": "0.23.0",
    "vitest": "5.0.1",
    "@types/node": "22.20.3",
    "@types/react": "18.3.31",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@deepseek-ai/dsh-attachment-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5"
  }
}
