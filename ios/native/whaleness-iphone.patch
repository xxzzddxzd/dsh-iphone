+            guard let endpoint = URLComponents(string: value) else { return false }
+            return endpoint.scheme == "ws" && endpoint.host == "127.0.0.1" &&
+                endpoint.port == 3080 && endpoint.path == "/ws/mobile"
+        }) else { throw GatewayProfileError.address }
+        return raw
+    }
