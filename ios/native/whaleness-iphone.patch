+struct NativeCredentialView: View {
+    let reference: String
+    @StateObject private var page: NativeSettingsPage
+    @Environment(\.scenePhase) private var scenePhase
+    @State private var status: JSONValue = .null
+    @State private var key = ""
+    @State private var confirmsDelete = false
+    init(client: NativeSettingsClient, reference: String) {
+        self.reference = reference; _page = StateObject(wrappedValue: NativeSettingsPage(client))
+    }
+    private var writable: Bool { status["writable"]?.boolValue == true }
+    var body: some View {
+        Form {
+            Section("当前生效引用") {
+                NativeSettingsFeedback(page: page)
+                Text(reference).font(.body.monospaced()).textSelection(.enabled)
+                LabeledContent("状态", value: status.objectValue == nil ? "未读取" : status["configured"]?.boolValue == true ? "已配置" : "未配置")
+                if let source = status["source"]?.stringValue { LabeledContent("来源", value: source) }
+                if status.objectValue != nil && !writable { Text("后台凭据存储当前不可写。") .font(.footnote).foregroundStyle(.secondary) }
+                Button("刷新配置状态") { Task { await refresh() } }.disabled(page.busy)
+            }
+            Section {
+                SecureField("粘贴新的 API Key", text: $key).textInputAutocapitalization(.never).autocorrectionDisabled()
+                Button("保存到后台") {
+                    let input = key; key = ""
+                    Task {
+                        guard await page.call(.plugin, "credentials.set", ["ref": .string(reference), "value": .string(input)]) != nil else { return }
+                        await refresh(); page.notice = "新凭据已保存到后台"
+                    }
+                }.disabled(page.busy || !writable || key.isEmpty)
+            } header: { Text("更新凭据") } footer: {
+                Text("现有密钥不会返回 App，也不会显示或回填。新输入只在本页临时内存中使用，离页或进入后台即清空。")
+            }
+            Section {
+                Button("删除本地保存值", role: .destructive) { confirmsDelete = true }.disabled(page.busy || !writable)
+            } footer: { Text("删除只移除后台管理层保存的值。若环境变量、项目或其他来源仍提供同名引用，它仍可能显示已配置。") }
+        }
+        .navigationTitle("管理后台凭据").nativeSettingsLifecycle(page)
+        .task { await refresh() }
+        .onDisappear { key = "" }
+        .onChange(of: scenePhase) { if $0 == .background { key = "" } }
+        .confirmationDialog("删除此引用的本地保存值？", isPresented: $confirmsDelete, titleVisibility: .visible) {
+            Button("删除本地保存值", role: .destructive) {
+                key = ""
+                Task {
+                    guard let result = await page.call(.plugin, "credentials.unset", ["ref": .string(reference)]) else { return }
+                    await refresh()
+                    page.notice = result["removed"]?.boolValue == false ? "没有可删除的本地保存值；外部来源保持不变" : "本地保存值已移除；请查看刷新后的实际来源"
+                }
+            }
+        } message: { Text("不会删除环境变量或外部来源。原始密钥不会发送回 App。") }
+    }
+    private func refresh() async {
+        guard NativeCredentialPolicy.isValidReference(reference) else { page.error = "此后台凭据引用名无效。"; return }
+        guard let response = await page.call(.plugin, "credentials.describe", ["refs": .array([.string(reference)])]) else { return }
+        guard let raw = response[reference], let projection = NativeCredentialPolicy.publicStatus(raw) else {
+            page.error = "后台未返回可识别的凭据状态。"; return
+        }
+        status = projection
+    }
+}
