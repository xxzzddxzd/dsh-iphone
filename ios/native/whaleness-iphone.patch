+struct NativeQuotaView: View {
+    let value: JSONValue
+    static func windowLabel(_ value: Double?) -> String {
+        guard let value, value.isFinite, value >= 1, value < Double(Int.max), value.rounded() == value else { return "未提供" }
+        let seconds = Int(value)
+        if seconds % 86400 == 0 { return "\(seconds / 86400) 天" }
+        if seconds % 3600 == 0 { return "\(seconds / 3600) 小时" }
+        if seconds % 60 == 0 { return "\(seconds / 60) 分钟" }
+        return "\(seconds) 秒"
+    }
+    var body: some View {
+        ForEach(value["rateLimits"]?.arrayValue ?? [], id: \.self) { limit in
+            VStack(alignment: .leading, spacing: 8) {
+                Text(limit["name"]?.stringValue ?? limit["id"]?.stringValue ?? "额度")
+                ForEach(limit["windows"]?.arrayValue ?? [], id: \.self) { window in
+                    if let percent = window["remainingPercent"]?.doubleValue {
+                        ProgressView(value: min(100, max(0, percent)), total: 100)
+                        Text("剩余 \(percent, specifier: "%.1f")% · \(Self.windowLabel(window["windowSeconds"]?.doubleValue))窗口")
+                            .font(.footnote).foregroundStyle(.secondary)
+                    }
+                }
+            }
+        }
+        if let credits = value["credits"] {
+            LabeledContent("积分", value: credits["unlimited"]?.boolValue == true ? "不限额" : (credits["balance"]?.nativeText ?? "未提供"))
+        }
+        if let individual = value["individualLimit"] {
+            LabeledContent("成员剩余额度", value: individual["remaining"]?.nativeText ?? "未提供")
+        }
+        if value["rateLimits"]?.arrayValue?.isEmpty != false && value["credits"] == nil && value["individualLimit"] == nil {
+            Text("上游未提供额度数据").foregroundStyle(.secondary)
+        }
+    }
+}
