diff --git a/DeepSeekHarnessMobile/Core/NativeSettingsClient.swift b/DeepSeekHarnessMobile/Core/NativeSettingsClient.swift
new file mode 100644
index 0000000000000000000000000000000000000000..cda02d26a7a6e8a46876eea2e860dbec5630c2ae
--- /dev/null
+++ b/DeepSeekHarnessMobile/Core/NativeSettingsClient.swift
@@ -0,0 +1,154 @@
+import Foundation
+
+/// A request-scoped client over the already authenticated control connection.
+/// Settings, account keys and OAuth credentials remain owned by the Host.
+actor NativeSettingsClient {
+    enum Scope: String, Codable, Sendable { case provider, plugin; case clinePass = "cline-pass" }
+    enum Failure: LocalizedError {
+        case disconnected, timedOut, invalidResponse, rejected(String)
+        var errorDescription: String? {
+            switch self {
+            case .disconnected: return "网关已断开，请连接后重试。"
+            case .timedOut: return "设置请求超时，请重试。"
+            case .invalidResponse: return "设置服务返回了无法识别的响应。"
+            case .rejected(let message): return message
+            }
+        }
+    }
+    typealias Transport = @Sendable (Data) async throws -> Void
+    private struct Pending {
+        let scope: Scope
+        let action: String
+        let provider: String?
+        let continuation: CheckedContinuation<JSONValue, Error>
+        let deadline: Task<Void, Never>
+    }
+    private let transport: Transport
+    private let catalogChanged: @Sendable () async -> Void
+    private var authStates: [String: String] = [:]
+    private let timeout: Duration
+    private var pending: [String: Pending] = [:]
+
+    init(timeout: Duration = .seconds(65), catalogChanged: @escaping @Sendable () async -> Void = {}, transport: @escaping Transport) {
+        self.timeout = timeout
+        self.catalogChanged = catalogChanged
+        self.transport = transport
+    }
+
+    func request(_ scope: Scope, _ action: String, payload: [String: JSONValue] = [:]) async throws -> JSONValue {
+        try Task.checkCancellation()
+        let requestID = UUID().uuidString
+        return try await withTaskCancellationHandler {
+            try await withCheckedThrowingContinuation { continuation in
+                let deadline = Task { [weak self, timeout] in
+                    do { try await Task.sleep(for: timeout) } catch { return }
+                    await self?.finish(requestID, .failure(Failure.timedOut))
+                }
+                pending[requestID] = Pending(scope: scope, action: action, provider: payload["provider"]?.stringValue, continuation: continuation, deadline: deadline)
+                let wire: JSONValue = .object([
+                    "type": .string("native-settings"), "requestId": .string(requestID),
+                    "scope": .string(scope.rawValue), "action": .string(action), "payload": .object(payload)
+                ])
+                Task {
+                    do {
+                        guard pending[requestID] != nil else { return }
+                        try Task.checkCancellation()
+                        let data = try JSONEncoder().encode(wire)
+                        try await transport(data)
+                    } catch { finish(requestID, .failure(error)) }
+                }
+            }
+        } onCancel: {
+            Task { await self.finish(requestID, .failure(CancellationError())) }
+        }
+    }
+
+    /// Header recognition is synchronous so settings replies never enter KMP or generic alerts.
+    nonisolated static func consumes(_ data: Data) -> Bool {
+        struct Header: Decodable { let kind: String?; let requestType: String? }
+        guard let header = try? JSONDecoder().decode(Header.self, from: data) else { return false }
+        return header.kind == "native-settings" || (header.kind == "error" && header.requestType == "native-settings")
+    }
+
+    func receive(_ data: Data) {
+        guard let frame = try? JSONDecoder().decode(JSONValue.self, from: data),
+              let requestID = frame["requestId"]?.stringValue, let request = pending[requestID] else { return }
+        if frame["kind"]?.stringValue == "error" {
+            let raw = frame["message"]?.stringValue ?? "设置服务暂不可用。"
+            let safe = raw.replacingOccurrences(of: "vless://[^\\s]+", with: "vless://[已隐藏]", options: .regularExpression)
+                .replacingOccurrences(of: "(?i)(access_token|refresh_token|token|code)=([^&\\s]+)", with: "$1=[已隐藏]", options: .regularExpression)
+                .replacingOccurrences(of: "(?:sk-|xai-)[A-Za-z0-9_-]{12,}", with: "[密钥已隐藏]", options: .regularExpression)
+            // Do not store diagnostics, request bodies or account secrets in logs.
+            finish(requestID, .failure(Failure.rejected(String(safe.prefix(500)))))
+            return
+        }
+        guard frame["scope"]?.stringValue == request.scope.rawValue,
+              frame["action"]?.stringValue == request.action,
+              let value = frame["value"] else {
+            finish(requestID, .failure(Failure.invalidResponse)); return
+        }
+        finish(requestID, .success(value))
+        if request.scope == .provider, request.action == "auth.logout", let provider = request.provider { authStates[provider] = "signed-out" }
+        var refresh = request.scope == .provider && ["models.set", "auth.logout"].contains(request.action)
+        if request.scope == .provider, request.action == "auth.status", let provider = request.provider,
+           let status = value["status"]?.stringValue {
+            refresh = status == "signed-in" && authStates[provider] != status
+            authStates[provider] = status
+        }
+        if request.scope == .clinePass {
+            refresh = ["key.set", "account.add", "account.remove", "account.mode", "account.enable", "model.visibility", "models.visibility", "models.refresh"].contains(request.action)
+        }
+        if request.scope == .plugin && ["mutate", "credentials.set", "credentials.unset"].contains(request.action) { refresh = true }
+        if refresh { Task { await catalogChanged() } }
+    }
+
+    func invalidate() {
+        let requests = pending
+        pending.removeAll()
+        for item in requests.values {
+            item.deadline.cancel()
+            item.continuation.resume(throwing: Failure.disconnected)
+        }
+    }
+
+    private func finish(_ id: String, _ result: Result<JSONValue, Error>) {
+        guard let item = pending.removeValue(forKey: id) else { return }
+        item.deadline.cancel()
+        item.continuation.resume(with: result)
+    }
+}
+
+extension JSONValue {
+    var nativeText: String {
+        switch self {
+        case .string(let value): return value
+        case .number(let value): return value.rounded() == value ? String(format: "%.0f", value) : String(value)
+        case .bool(let value): return value ? "是" : "否"
+        case .null: return "未设置"
+        case .array(let values): return "\(values.count) 项"
+        case .object(let values): return "\(values.count) 个配置项"
+        }
+    }
+    func nativeValue(at path: [String]) -> JSONValue? {
+        guard let first = path.first else { return self }
+        if case .array(let items) = self, let index = Int(first), items.indices.contains(index) {
+            return items[index].nativeValue(at: Array(path.dropFirst()))
+        }
+        return self[first]?.nativeValue(at: Array(path.dropFirst()))
+    }
+    func nativeReplacing(at path: [String], with value: JSONValue?) -> JSONValue {
+        guard let first = path.first else { return value ?? .null }
+        let tail = Array(path.dropFirst())
+        if case .array(var items) = self {
+            guard let index = Int(first), items.indices.contains(index) else { return self }
+            if tail.isEmpty && value == nil { items.remove(at: index) }
+            else { items[index] = items[index].nativeReplacing(at: tail, with: value) }
+            return .array(items)
+        }
+        var items = objectValue ?? [:]
+        if value == nil && items[first] == nil { return self }
+        if tail.isEmpty { items[first] = value }
+        else { items[first] = (items[first] ?? .object([:])).nativeReplacing(at: tail, with: value) }
+        return .object(items)
+    }
+}
