+struct NativeProviderModelsView: View {
+    let provider: String
+    @StateObject private var page: NativeSettingsPage
+    @State private var models: [NativeModelDraft] = []
+    @State private var search = ""
+    init(client: NativeSettingsClient, provider: String) { self.provider = provider; _page = StateObject(wrappedValue: NativeSettingsPage(client)) }
+    var body: some View {
+        Form {
+            Section { NativeSettingsFeedback(page: page) }
+            ForEach(models.indices.filter { search.isEmpty || models[$0].name.localizedCaseInsensitiveContains(search) || models[$0].id.localizedCaseInsensitiveContains(search) }, id: \.self) { index in
+                Section {
+                    Toggle(models[index].name, isOn: $models[index].visible)
+                    DisclosureGroup("上下文与输出容量") {
+                        Text(models[index].id).font(.caption.monospaced()).foregroundStyle(.secondary)
+                        TextField("上下文，默认 \(models[index].contextDefault)", text: $models[index].context).keyboardType(.numberPad)
+                        TextField("最大输出，默认 \(models[index].outputDefault)", text: $models[index].output).keyboardType(.numberPad)
+                    }
+                }
+            }
+            Section { Text("容量留空会清除覆盖值，恢复 Provider 默认。配置不能突破上游真实限制。")
+                .font(.footnote).foregroundStyle(.secondary) }
+        }
+        .navigationTitle("模型显隐与容量").nativeSettingsLifecycle(page)
+        .searchable(text: $search, prompt: "搜索模型")
+        .toolbar { Button("保存") { Task { await save() } }.disabled(page.busy || models.isEmpty) }
+        .task { await load() }
+    }
+    private func load() async {
+        if let value = await page.call(.provider, "models.get", ["provider": .string(provider)]) {
+            models = (value["models"]?.arrayValue ?? []).map(NativeModelDraft.init)
+        }
+    }
+    private func save() async {
+        do {
+            let values = try models.filter(\.hasOverride).map { try $0.payload() }
+            if await page.call(.provider, "models.set", ["provider": .string(provider), "models": .array(values)]) != nil {
+                page.notice = "模型设置已保存"
+            }
+        } catch { page.error = error.localizedDescription }
+    }
+}
