+struct NativeSchemaField: View {
+    @ObservedObject var editor: NativePluginEditor
+    let client: NativeSettingsClient
+    let node: JSONValue
+    let path: [String]
+    let name: String
+    let depth: Int
+    private var title: String { node["meta"]?["title"]?.stringValue ?? name }
+    var body: some View { content }
+    private var content: AnyView {
+        guard depth < 12 else { return AnyView(Text("\(title)：嵌套过深，暂为只读").foregroundStyle(.secondary)) }
+        let graph = editor.graph
+        let current = editor.value(path, default: node["meta"]?["default"] ?? .null)
+        if editor.isSecret(path, node: node) {
+            return AnyView(VStack(alignment: .leading, spacing: 5) {
+                SecureField(title, text: Binding(get: { editor.secretText[editor.key(path)] ?? "" }, set: { editor.setSecret(path, $0) }))
+                    .textInputAutocapitalization(.never).autocorrectionDisabled()
+                Text(editor.secretConfigured(path) ? "已配置；留空保持原密钥" : "尚未配置")
+                    .font(.footnote).foregroundStyle(.secondary)
+            })
+        }
+        if let choices = graph.choices(node) {
+            return AnyView(Picker(title, selection: Binding(get: { current }, set: { editor.set(path, $0) })) {
+                if !choices.contains(.null) { Text("未设置").tag(JSONValue.null) }
+                ForEach(choices, id: \.self) { value in Text(value.nativeText).tag(value) }
+            })
+        }
+        switch node["type"]?.stringValue {
+        case "object":
+            let fields = graph.fields(node)
+            return AnyView(VStack(alignment: .leading, spacing: 12) {
+                if !path.isEmpty { Text(title).font(.headline) }
+                ForEach(fields.indices, id: \.self) { index in
+                    NativeSchemaField(editor: editor, client: client, node: fields[index].1, path: path + [fields[index].0], name: fields[index].0, depth: depth + 1)
+                }
+            })
+        case "dict":
+            let keys = current.objectValue?.keys.sorted() ?? []
+            return AnyView(DisclosureGroup(title) {
+                ForEach(keys, id: \.self) { key in
+                    NativeSchemaField(editor: editor, client: client, node: graph.resolve(node["inner"]), path: path + [key], name: key, depth: depth + 1)
+                }
+                if keys.isEmpty { Text("暂无条目；此动态键集合暂为只读。").font(.footnote).foregroundStyle(.secondary) }
+            })
+        case "array":
+            let items = current.arrayValue ?? []
+            let inner = graph.resolve(node["inner"] ?? node["items"])
+            let protected = editor.hasSecrets(below: path) || graph.containsSecret(inner)
+            return AnyView(DisclosureGroup("\(title)（\(items.count)项）") {
+                ForEach(Array(items.indices.prefix(200)), id: \.self) { index in
+                    VStack(alignment: .leading) {
+                        NativeSchemaField(editor: editor, client: client, node: inner, path: path + [String(index)], name: "第\(index + 1)项", depth: depth + 1)
+                        if !protected { Button("移除此项", role: .destructive) {
+                            var next = items; next.remove(at: index); editor.set(path, .array(next))
+                        }.font(.footnote) }
+                    }.padding(.leading, 5)
+                }
+                if items.count > 200 { Text("只展示前200项，其他项仍会保留。") .font(.footnote).foregroundStyle(.secondary) }
+                if protected { Text("含已保存密钥的数组只支持字段修改。") .font(.footnote).foregroundStyle(.secondary) }
+                else { Button("添加一项") { editor.set(path, .array(items + [graph.initialValue(inner)])) } }
+            })
+        case "boolean":
+            return AnyView(Toggle(title, isOn: Binding(get: { current.boolValue ?? false }, set: { editor.set(path, .bool($0)) })))
+        case "string":
+            return AnyView(VStack(alignment: .leading, spacing: 4) {
+                TextField(title, text: Binding(get: { current.stringValue ?? "" }, set: { editor.set(path, .string($0)) }), axis: .vertical)
+                    .textInputAutocapitalization(.never).autocorrectionDisabled().lineLimit(1...5)
+                if node["meta"]?["role"]?.stringValue == "credential-ref" {
+                    if let reference = editor.effectiveCredentialReference(path) {
+                        NavigationLink("管理此凭据（\(reference)）") { NativeCredentialView(client: client, reference: reference) }
+                        if current.stringValue != reference {
+                            Text("新引用尚未保存；此入口管理当前生效引用。请先保存配置，再管理新引用。")
+                                .font(.footnote).foregroundStyle(.secondary)
+                        }
+                    } else {
+                        Text("请先保存有效的后台凭据引用名，然后管理对应的 API Key。") .font(.footnote).foregroundStyle(.secondary)
+                    }
+                }
+            })
+        case "number", "integer":
+            return AnyView(VStack(alignment: .leading, spacing: 4) {
+                TextField(title, text: Binding(get: { editor.numericText[editor.key(path)] ?? (current == .null ? "" : current.nativeText) }, set: { editor.setNumber(path, $0, node: node) }))
+                    .keyboardType(.numbersAndPunctuation)
+                if let error = editor.errors[editor.key(path)] { Text(error).foregroundStyle(.red).font(.footnote) }
+            })
+        case "const": return AnyView(LabeledContent(title, value: node["value"]?.nativeText ?? "固定值"))
+        default:
+            return AnyView(VStack(alignment: .leading, spacing: 4) {
+                LabeledContent(title, value: current.nativeText)
+                Text("此复杂类型暂不支持原生编辑，可在原网页设置中修改。") .font(.footnote).foregroundStyle(.secondary)
+            })
+        }
+    }
+}
