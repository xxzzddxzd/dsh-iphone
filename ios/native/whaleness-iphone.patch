+struct NativeCredentialPolicy {
+    static func isValidReference(_ reference: String) -> Bool {
+        guard reference.utf8.count <= 128, !reference.isEmpty,
+              let range = reference.range(of: "^[A-Za-z_][A-Za-z0-9_]*$", options: .regularExpression) else { return false }
+        return range == reference.startIndex..<reference.endIndex
+    }
+    static func publicStatus(_ value: JSONValue) -> JSONValue? {
+        guard let configured = value["configured"]?.boolValue, let writable = value["writable"]?.boolValue else { return nil }
+        var result: [String: JSONValue] = ["configured": .bool(configured), "writable": .bool(writable)]
+        if let source = value["source"]?.stringValue { result["source"] = .string(String(source.prefix(120))) }
+        return .object(result)
+    }
+}
