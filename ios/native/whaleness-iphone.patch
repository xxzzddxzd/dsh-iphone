+private struct NativeModelDraft: Identifiable {
+    let id: String; let name: String; let contextDefault: String; let outputDefault: String
+    var visible: Bool; var context: String; var output: String
+    init(_ value: JSONValue) {
+        id = value["id"]?.stringValue ?? ""; name = value["name"]?.stringValue ?? id
+        visible = value["visible"]?.boolValue ?? true
+        context = value["contextWindow"]?.nativeText ?? ""; output = value["maxTokens"]?.nativeText ?? ""
+        contextDefault = value["defaultContextWindow"]?.nativeText ?? "未提供"
+        outputDefault = value["defaultMaxTokens"]?.nativeText ?? "未提供"
+    }
+    var hasOverride: Bool { !visible || !context.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty || !output.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty }
+    func payload() throws -> JSONValue {
+        var value: [String: JSONValue] = ["id": .string(id), "visible": .bool(visible)]
+        for (key, text) in [("contextWindow", context), ("maxTokens", output)] {
+            guard !text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else { continue }
+            guard let number = Double(text), number.isFinite, number >= 1, number.rounded() == number, number <= 9_007_199_254_740_991 else {
+                throw NativeSettingsClient.Failure.rejected("\(name) 的容量必须是正整数；留空使用默认值。")
+            }
+            value[key] = .number(number)
+        }
+        return .object(value)
+    }
+}
