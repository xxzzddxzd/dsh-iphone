+struct NativeProviderDetailView: View {
+    let provider: String
+    let name: String
+    @Environment(\.openURL) private var openURL
+    @Environment(\.scenePhase) private var scenePhase
+    @StateObject private var page: NativeSettingsPage
+    @State private var auth: JSONValue = .null
+    @State private var egress: JSONValue = .null
+    @State private var selectedEgress = "direct"
+    @State private var loginURL: URL?
+    @State private var loginCode: String?
+    @State private var confirmsLogout = false
+    @State private var loginInProgress = false
+    init(client: NativeSettingsClient, provider: String, name: String) {
+        self.provider = provider; self.name = name
+        _page = StateObject(wrappedValue: NativeSettingsPage(client))
+    }
+    private var signingIn: Bool { loginInProgress || auth["status"]?.stringValue == "signing-in" }
+    var body: some View {
+        Form {
+            Section("账号") {
+                NativeSettingsFeedback(page: page)
+                LabeledContent("状态", value: statusLabel)
+                if let message = auth["message"]?.stringValue { Text(message).foregroundStyle(.secondary).font(.footnote) }
+                if provider == "provider-google", auth["configured"]?.boolValue == false {
+                    Text("后台尚未配置 Google OAuth。可在其他插件配置中检查相关 OAuth 插件。")
+                        .font(.footnote).foregroundStyle(.secondary)
+                }
+                Button(signingIn ? "重新打开授权网页" : "登录或重新授权") {
+                    Task { await login() }
+                }.disabled(page.busy || (provider == "provider-google" && auth["configured"]?.boolValue == false))
+                if let loginCode { LabeledContent("授权码") { Text(loginCode).textSelection(.enabled) } }
+                if let loginURL { Link("打开授权网页", destination: loginURL) }
+                Button("刷新账号与额度") { Task { await refreshAuth() } }.disabled(page.busy)
+                if auth["status"]?.stringValue == "signed-in" || signingIn {
+                    Button("退出此 Provider 登录", role: .destructive) { confirmsLogout = true }.disabled(page.busy)
+                }
+            }
+            if let usage = auth["usage"] {
+                Section("使用额度") { NativeQuotaView(value: usage) }
+            }
+            if let error = auth["quotaError"]?.stringValue { Section { Text(error).foregroundStyle(.secondary).font(.footnote) } }
+            Section("模型") {
+                NavigationLink { NativeProviderModelsView(client: page.client, provider: provider) } label: {
+                    Label("模型显隐与容量", systemImage: "list.bullet.rectangle")
+                }
+            }
+            if provider == "provider-codex" {
+                Section("工具与请求") {
+                    NavigationLink { NativeProviderToolSettingsView(client: page.client) } label: {
+                        Label("图片工具与 Responses API", systemImage: "photo.badge.gearshape")
+                    }
+                }
+            }
+            if provider == "provider-xai" {
+                Section("图片") {
+                    NavigationLink { NativeXaiImageSettingsView(client: page.client) } label: {
+                        Label("Grok 图片模型", systemImage: "photo")
+                    }
+                }
+            }
+            Section {
+                Picker("此 Provider 的出口", selection: $selectedEgress) {
+                    Text("直连").tag("direct"); Text("VLESS").tag("vless")
+                }
+                if let node = egress["node"]?.stringValue { Text(node).font(.footnote).foregroundStyle(.secondary) }
+                if let message = egress["message"]?.stringValue { Text(message).font(.footnote).foregroundStyle(.secondary) }
+                Button("保存出口") { Task { await saveEgress() } }.disabled(page.busy || egress.objectValue == nil)
+                NavigationLink { NativeVlessSettingsView(client: page.client) } label: { Text("管理共享 VLESS 节点") }
+            } header: { Text("网络") } footer: { Text("每个 Provider 独立选择出口；节点与连接状态仍由手机上的后台管理。") }
+        }
+        .navigationTitle(name).nativeSettingsLifecycle(page)
+        .task { await refreshAuth(); await loadEgress() }
+        .task(id: "\(scenePhase)-\(signingIn)") {
+            guard scenePhase == .active, signingIn else { return }
+            for _ in 0..<45 {
+                do { try await Task.sleep(for: .seconds(2)) } catch { return }
+                guard !Task.isCancelled, scenePhase == .active else { return }
+                do {
+                    let next = try await page.client.request(.provider, "auth.status", payload: ["provider": .string(provider)])
+                    guard !Task.isCancelled else { return }
+                    acceptAuth(next)
+                    if !signingIn { return }
+                } catch { return }
+            }
+            loginInProgress = false
+            page.notice = "授权状态尚未确认，可以手动刷新或重新打开授权网页。"
+        }
+        .confirmationDialog("退出 \(name) 登录？", isPresented: $confirmsLogout, titleVisibility: .visible) {
+            Button("退出登录", role: .destructive) {
+                Task {
+                    if await page.call(.provider, "auth.logout", ["provider": .string(provider)]) != nil {
+                        loginURL = nil; loginCode = nil; loginInProgress = false; await refreshAuth()
+                    }
+                }
+            }
+        }
+    }
+    private var statusLabel: String {
+        if signingIn && auth["status"]?.stringValue != "signed-in" { return "正在授权" }
+        switch auth["status"]?.stringValue {
+        case "signed-in": return "已登录"
+        case "signing-in": return "正在授权"
+        case "signed-out": return "未登录"
+        case "error": return "登录异常"
+        default: return "未读取"
+        }
+    }
+    private func acceptAuth(_ value: JSONValue) {
+        auth = value
+        if value["status"]?.stringValue == "signed-in" || value["status"]?.stringValue == "error" {
+            loginInProgress = false; loginURL = nil; loginCode = nil
+        }
+    }
+    private func refreshAuth() async {
+        if let value = await page.call(.provider, "auth.status", ["provider": .string(provider)]) { acceptAuth(value) }
+    }
+    private func loadEgress() async {
+        if let value = await page.call(.provider, "egress.get", ["provider": .string(provider)]) {
+            egress = value; selectedEgress = value["egress"]?.stringValue ?? "direct"
+        }
+    }
+    private func saveEgress() async {
+        if let value = await page.call(.provider, "egress.set", ["provider": .string(provider), "egress": .string(selectedEgress)]) {
+            egress = value; page.notice = "出口已保存"
+        }
+    }
+    private func login() async {
+        if signingIn, let loginURL { openURL(loginURL); return }
+        guard let value = await page.call(.provider, "auth.login", ["provider": .string(provider)]),
+              let raw = value["url"]?.stringValue, let url = URL(string: raw),
+              Self.acceptsAuthorizationURL(url, provider: provider) else {
+            if page.error == nil { page.error = "无法取得受支持的官方授权地址。" }; return
+        }
+        loginURL = url; loginCode = value["userCode"]?.stringValue
+        auth = .object(["status": .string("signing-in")]); loginInProgress = true
+        openURL(url)
+    }
+    static func acceptsAuthorizationURL(_ url: URL, provider: String) -> Bool {
+        guard url.scheme?.lowercased() == "https", url.user == nil, url.password == nil,
+              let host = url.host?.lowercased() else { return false }
+        let suffixes: [String]
+        switch provider {
+        case "provider-codex": suffixes = ["openai.com", "chatgpt.com"]
+        case "provider-xai": suffixes = ["x.ai", "grok.com"]
+        case "provider-google": suffixes = ["google.com"]
+        default: return false
+        }
+        return suffixes.contains { host == $0 || host.hasSuffix("." + $0) }
+    }
+}
