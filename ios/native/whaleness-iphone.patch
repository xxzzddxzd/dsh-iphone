+              url.user == nil, url.password == nil, url.port == nil, url.fragment == nil,
+              let parts = URLComponents(url: url, resolvingAgainstBaseURL: false),
+              let items = parts.queryItems, items.count == 1,
+              items[0].name == "payload", let raw = items[0].value, raw.count <= 16_384 else {
+            throw GatewayProfileError.address
+        }
+        let payload = try PairingPayloadParser.parse(raw, now: now)
+        guard payload.gatewayId != nil, payload.expirationDate.timeIntervalSince(now) <= 600 else {
+            throw GatewayProfileError.identity
