+import SwiftUI
+
+@MainActor
+final class NativeSettingsPage: ObservableObject {
+    let client: NativeSettingsClient
+    @Published var busy = false
+    @Published var error: String?
+    @Published var notice: String?
+    private var operation: Task<JSONValue, Error>?
+    private var generation = UUID()
+    init(_ client: NativeSettingsClient) { self.client = client }
+    func call(_ scope: NativeSettingsClient.Scope, _ action: String, _ payload: [String: JSONValue] = [:]) async -> JSONValue? {
+        guard !busy, !Task.isCancelled else { return nil }
+        busy = true; error = nil; notice = nil
+        let current = UUID(); generation = current
+        let task = Task { try await client.request(scope, action, payload: payload) }
+        operation = task
+        defer { if generation == current { operation = nil; busy = false } }
+        do {
+            let value = try await withTaskCancellationHandler { try await task.value } onCancel: { task.cancel() }
+            guard generation == current, !Task.isCancelled else { return nil }
+            return value
+        }
+        catch is CancellationError { return nil }
+        catch { if !Task.isCancelled && generation == current { self.error = error.localizedDescription }; return nil }
+    }
+    func cancel() {
+        generation = UUID(); operation?.cancel(); operation = nil; busy = false
+    }
+}
+
+private struct NativeSettingsLifecycle: ViewModifier {
+    @Environment(\.scenePhase) private var scenePhase
+    let page: NativeSettingsPage
+    func body(content: Content) -> some View {
+        content.onDisappear { page.cancel() }.onChange(of: scenePhase) { phase in
+            if phase == .background { page.cancel() }
+        }
+    }
+}
