+struct NativePluginNamespaceView: View {
+    let writable: Bool
+    @StateObject private var page: NativeSettingsPage
+    @StateObject private var editor = NativePluginEditor()
+    @State private var original: JSONValue
+    @State private var confirmsReload = false
+    @Environment(\.scenePhase) private var scenePhase
+    init(client: NativeSettingsClient, namespace: JSONValue, writable: Bool) {
+        self.writable = writable; _original = State(initialValue: namespace)
+        _page = StateObject(wrappedValue: NativeSettingsPage(client))
+    }
+    var body: some View {
+        Form {
+            Section { NativeSettingsFeedback(page: page)
+                if let notice = editor.notice { Text(notice).font(.footnote).foregroundStyle(.secondary) }
+                Text("保存只提交你修改的字段；并发版本变化会由后台拒绝，防止覆盖其他界面的修改。")
+                    .font(.footnote).foregroundStyle(.secondary)
+            }
+            Section {
+                NativeSchemaField(editor: editor, client: page.client, node: editor.graph.root, path: [], name: "配置", depth: 0).buttonStyle(.borderless)
+            }.disabled(!writable || page.busy)
+            if !editor.errors.isEmpty { Section { Text("请先修正标红的数字字段。") .foregroundStyle(.red) } }
+            Section {
+                Button("重新读取后台配置") { confirmsReload = true }.disabled(page.busy)
+            }
+        }.navigationTitle(editor.namespace.isEmpty ? "插件配置" : editor.namespace).nativeSettingsLifecycle(page)
+        .toolbar { Button("保存") { Task { await save() } }.disabled(!writable || page.busy || editor.changes.isEmpty || !editor.errors.isEmpty) }
+        .onAppear { if editor.namespace.isEmpty { editor.reset(original) } }
+        .onDisappear { editor.clearSensitive() }
+        .onChange(of: scenePhase) { if $0 == .background { editor.clearSensitive() } }
+        .confirmationDialog("放弃未保存的更改并重新读取？", isPresented: $confirmsReload, titleVisibility: .visible) {
+            Button("重新读取") { Task { await refresh() } }
+        }
+    }
+    private func refresh() async {
+        guard let next = await page.call(.plugin, "describe"),
+              let current = next["namespaces"]?.arrayValue?.first(where: { $0["ns"]?.stringValue == editor.namespace }) else { return }
+        original = current; editor.reset(current)
+    }
+    private func save() async {
+        let payload: [String: JSONValue] = ["ns": .string(editor.namespace), "expectedRevision": editor.revision, "ops": .array(editor.operations)]
+        if await page.call(.plugin, "mutate", payload) != nil {
+            await refresh(); page.notice = "配置已保存"
+        }
+    }
+}
