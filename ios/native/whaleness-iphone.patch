+struct NativeSchemaGraph {
+    let envelope: JSONValue
+    func resolve(_ reference: JSONValue?) -> JSONValue {
+        guard let reference else { return .null }
+        if let number = reference.doubleValue, number.isFinite, number.rounded() == number {
+            return envelope["refs"]?[String(format: "%.0f", number)] ?? .null
+        }
+        return reference
+    }
+    var root: JSONValue { envelope["uid"] == nil ? envelope : resolve(envelope["uid"]) }
+    func fields(_ node: JSONValue) -> [(String, JSONValue)] {
+        let dictionary = node["dict"]?.objectValue ?? node["properties"]?.objectValue ?? [:]
+        return dictionary.keys.sorted().map { ($0, resolve(dictionary[$0])) }
+    }
+    func choices(_ node: JSONValue) -> [JSONValue]? {
+        if let values = node["enum"]?.arrayValue { return values }
+        guard node["type"]?.stringValue == "union", let list = node["list"]?.arrayValue else { return nil }
+        let nodes = list.map { resolve($0) }
+        guard nodes.allSatisfy({ $0["type"]?.stringValue == "const" && $0["value"] != nil }) else { return nil }
+        return nodes.compactMap { $0["value"] }
+    }
+    func containsSecret(_ node: JSONValue, depth: Int = 0) -> Bool {
+        if node["meta"]?["role"]?.stringValue == "secret" { return true }
+        guard depth < 10 else { return true }
+        if fields(node).contains(where: { containsSecret($0.1, depth: depth + 1) }) { return true }
+        if let inner = node["inner"], containsSecret(resolve(inner), depth: depth + 1) { return true }
+        return (node["list"]?.arrayValue ?? []).contains { containsSecret(resolve($0), depth: depth + 1) }
+    }
+    func initialValue(_ node: JSONValue, depth: Int = 0) -> JSONValue {
+        if let value = node["meta"]?["default"] { return value }
+        guard depth < 8 else { return .null }
+        if let first = choices(node)?.first { return first }
+        switch node["type"]?.stringValue {
+        case "boolean": return .bool(false)
+        case "string": return .string("")
+        case "number": return .number(node["meta"]?["min"]?.doubleValue ?? 0)
+        case "object": return .object(Dictionary(uniqueKeysWithValues: fields(node).map { ($0.0, initialValue($0.1, depth: depth + 1)) }))
+        case "array": return .array([])
+        default: return .null
+        }
+    }
+}
+
+@MainActor
+final class NativePluginEditor: ObservableObject {
+    struct Edit { let path: [String]; let value: JSONValue? }
+    @Published var snapshot: JSONValue = .null
+    @Published var draft: JSONValue = .object([:])
+    @Published var changes: [String: Edit] = [:]
+    @Published var errors: [String: String] = [:]
+    @Published var numericText: [String: String] = [:]
+    @Published var secretText: [String: String] = [:]
+    @Published var notice: String?
+    private var sensitivePaths = Set<[String]>()
+    var graph: NativeSchemaGraph { NativeSchemaGraph(envelope: snapshot["schema"] ?? .null) }
+    var revision: JSONValue { snapshot["revision"] ?? .number(0) }
+    var namespace: String { snapshot["ns"]?.stringValue ?? "" }
+    var secretPaths: [[String]] {
+        (snapshot["secrets"]?.arrayValue ?? []).map { ($0["path"]?.arrayValue ?? []).compactMap(\.stringValue) }
+    }
+    func reset(_ value: JSONValue) {
+        clearSensitive()
+        snapshot = value; draft = value["value"] ?? .object([:]); changes = [:]; errors = [:]; numericText = [:]; notice = nil
+    }
+    func key(_ path: [String]) -> String { path.map { "\($0.utf8.count):\($0)" }.joined(separator: "/") }
+    func value(_ path: [String], default fallback: JSONValue = .null) -> JSONValue { draft.nativeValue(at: path) ?? fallback }
+    func set(_ path: [String], _ value: JSONValue) {
+        draft = draft.nativeReplacing(at: path, with: value)
+        record(path, value)
+    }
+    func unset(_ path: [String]) {
+        let fallback = snapshot["base"]?.nativeValue(at: path)
+        draft = draft.nativeReplacing(at: path, with: fallback)
+        record(path, nil); numericText[key(path)] = nil; errors[key(path)] = nil
+    }
+    private func record(_ path: [String], _ value: JSONValue?) {
+        // A structural array edit owns its descendants; later leaf edits update
+        // that already-pending parent rather than racing conflicting operations.
+        if let parent = changes.values.filter({ $0.path.count < path.count && path.starts(with: $0.path) }).min(by: { $0.path.count < $1.path.count }) {
+            changes[key(parent.path)] = Edit(path: parent.path, value: draft.nativeValue(at: parent.path))
+            return
+        }
+        for edit in changes.values.filter({ $0.path.count > path.count && $0.path.starts(with: path) }) { changes[key(edit.path)] = nil }
+        changes[key(path)] = Edit(path: path, value: value)
+    }
+    func isSecret(_ path: [String], node: JSONValue) -> Bool {
+        secretPaths.contains(path) || node["meta"]?["role"]?.stringValue == "secret"
+    }
+    func hasSecrets(below path: [String]) -> Bool { secretPaths.contains { $0.starts(with: path) } }
+    func effectiveCredentialReference(_ path: [String]) -> String? {
+        guard let value = snapshot["value"]?.nativeValue(at: path)?.stringValue,
+              NativeCredentialPolicy.isValidReference(value) else { return nil }
+        return value
+    }
+    func secretConfigured(_ path: [String]) -> Bool {
+        (snapshot["secrets"]?.arrayValue ?? []).contains { row in
+            (row["path"]?.arrayValue ?? []).compactMap(\.stringValue) == path && row["set"]?.boolValue == true
+        }
+    }
+    func setSecret(_ path: [String], _ text: String) {
+        sensitivePaths.insert(path); secretText[key(path)] = text
+        if text.isEmpty {
+            let parents = changes.values.filter { $0.path.count < path.count && path.starts(with: $0.path) }
+            if let parent = parents.min(by: { $0.path.count < $1.path.count }) {
+                changes[key(parent.path)] = nil
+                draft = draft.nativeReplacing(at: parent.path, with: snapshot["value"]?.nativeValue(at: parent.path))
+                notice = "为保留已存密钥，已撤回包含该字段的整体结构修改。"
+            } else { draft = draft.nativeReplacing(at: path, with: nil) }
+            changes[key(path)] = nil
+        } else { set(path, .string(text)) }
+    }
+    func setNumber(_ path: [String], _ text: String, node: JSONValue) {
+        let token = key(path); numericText[token] = text
+        if text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty { unset(path); return }
+        guard let number = Double(text), number.isFinite else { errors[token] = "请输入有效数字"; return }
+        if (node["meta"]?["step"]?.doubleValue == 1 || node["type"]?.stringValue == "integer"), number.rounded() != number {
+            errors[token] = "请输入整数"; return
+        }
+        if let min = node["meta"]?["min"]?.doubleValue, number < min { errors[token] = "不能小于 \(min)"; return }
+        if let max = node["meta"]?["max"]?.doubleValue, number > max { errors[token] = "不能大于 \(max)"; return }
+        errors[token] = nil; set(path, .number(number))
+    }
+    var operations: [JSONValue] {
+        changes.values.sorted { key($0.path) < key($1.path) }.map { edit in
+            var value: [String: JSONValue] = ["op": .string(edit.value == nil ? "unset" : "set"), "path": .array(edit.path.map(JSONValue.string))]
+            value["value"] = edit.value
+            return .object(value)
+        }
+    }
+    func clearSensitive() {
+        for path in sensitivePaths {
+            draft = draft.nativeReplacing(at: path, with: nil)
+            for edit in changes.values.filter({ path.starts(with: $0.path) || $0.path.starts(with: path) }) { changes[key(edit.path)] = nil }
+        }
+        secretText = [:]; sensitivePaths = []
+    }
+}
