+/** Narrow-header clearance for the rootless-iOS whale navigation launcher. */
+import { readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { describe, expect, it } from 'vitest'
+
+const css = readFileSync(
+  fileURLToPath(new URL('../src/client/skeleton/ConversationRoot.module.css', import.meta.url)),
+  'utf8',
+)
+
+describe('ConversationRoot.module.css mobile header', () => {
+  it('reserves safe-area-aware leading space without narrowing the conversation body', () => {
+    expect(css).toContain('@media (max-width: 1023px)')
+    expect(css).toMatch(
+      /\.header\s*\{\s*padding-left: max\(68px, calc\(env\(safe-area-inset-left\) \+ 64px\)\);\s*}/,
+    )
+    expect(css).not.toMatch(/\.root\s*\{[^}]*padding-left: max\(/)
+  })
+})
