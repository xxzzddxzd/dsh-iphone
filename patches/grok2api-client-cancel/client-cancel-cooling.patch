+type coolingRegressionReader func([]byte) (int, error)
+
+func (read coolingRegressionReader) Read(p []byte) (int, error) { return read(p) }
+
+type coolingRegressionBody struct {
+	io.Reader
+	closed bool
+}
+
+func (body *coolingRegressionBody) Close() error { body.closed = true; return nil }
+
+type coolingRegressionWriter struct{ gin.ResponseWriter }
+
+func (writer *coolingRegressionWriter) Write([]byte) (int, error) { return 0, io.ErrClosedPipe }
+
+func TestWriteResultDoesNotMisclassifyDownstreamCancellationAsUpstreamFailure(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, test := range []struct {
+		name         string
+		cancelOnRead bool
+		deadline     bool
+		writeFailure bool
+		readErr      error
+		wantCode     string
+	}{
+		{name: "downstream cancels upstream read", cancelOnRead: true, readErr: context.Canceled, wantCode: "request_canceled"},
+		{name: "downstream deadline", deadline: true, readErr: context.DeadlineExceeded, wantCode: "request_canceled"},
+		{name: "canceled stream ends at EOF", cancelOnRead: true, readErr: io.EOF, wantCode: "request_canceled"},
+		{name: "real upstream read failure", readErr: io.ErrUnexpectedEOF, wantCode: "upstream_stream_interrupted"},
+		{name: "real upstream incomplete EOF", readErr: io.EOF, wantCode: "upstream_stream_incomplete"},
+		{name: "downstream write failure", writeFailure: true, wantCode: "stream_interrupted"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			requestCtx, cancel := context.WithCancel(context.Background())
+			if test.deadline {
+				cancel()
+				requestCtx, cancel = context.WithDeadline(context.Background(), time.Now().Add(-time.Second))
+			}
+			defer cancel()
+			reader := coolingRegressionReader(func([]byte) (int, error) {
+				if test.cancelOnRead {
+					cancel()
+				}
+				return 0, test.readErr
+			})
+			var source io.Reader = reader
+			if test.writeFailure {
+				source = strings.NewReader("data: {}\n\n")
+			}
+			body := &coolingRegressionBody{Reader: source}
+			recorder := httptest.NewRecorder()
+			ginCtx, _ := gin.CreateTestContext(recorder)
+			ginCtx.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", nil).WithContext(requestCtx)
+			if test.writeFailure {
+				ginCtx.Writer = &coolingRegressionWriter{ginCtx.Writer}
+			}
+			var finalCode string
+			finalCalls := 0
+			result := &gateway.Result{StatusCode: http.StatusOK, Header: http.Header{"Content-Type": {"text/event-stream"}},
+				Body: body, Finalize: func(_ gateway.Usage, _ string, code string) { finalCode = code; finalCalls++ }}
+			NewHandler(nil, nil, 1<<20).writeResult(ginCtx, result, true, streamProtocolResponses)
+			if finalCode != test.wantCode || finalCalls != 1 || !body.closed {
+				t.Fatalf("final code=%q calls=%d closed=%v; want %q once and closed", finalCode, finalCalls, body.closed, test.wantCode)
+			}
+		})
+	}
+}
