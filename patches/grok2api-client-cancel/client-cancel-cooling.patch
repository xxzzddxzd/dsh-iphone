+func TestGatewayStreamFinalizationDoesNotCoolCanceledRequests(t *testing.T) {
+	for _, test := range []struct {
+		name      string
+		errorCode string
+		canceled  bool
+	}{
+		{name: "client-canceled-read", errorCode: "upstream_stream_interrupted", canceled: true},
+		{name: "client-canceled-eof", errorCode: "upstream_stream_incomplete", canceled: true},
+		{name: "upstream-read-failed", errorCode: "upstream_stream_interrupted"},
+		{name: "upstream-eof-incomplete", errorCode: "upstream_stream_incomplete"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			ctx := context.Background()
+			database, err := relational.OpenSQLite(ctx, filepath.Join(t.TempDir(), "stream-finalization.db"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer database.Close()
+			if err := database.InitializeSchema(ctx); err != nil {
+				t.Fatal(err)
+			}
+			accountRepo := relational.NewAccountRepository(database)
+			modelRepo := relational.NewModelRepository(database)
+			auditRepo := relational.NewAuditRepository(database)
+			responseRepo := relational.NewResponseRepository(database)
+			keyRepo := relational.NewClientKeyRepository(database)
+			credential, _, err := accountRepo.UpsertByIdentity(ctx, account.Credential{
+				Provider: account.ProviderBuild, Name: "fixture-account", SourceKey: "stream-finalization-fixture",
+				EncryptedAccessToken: "fixture-only", ExpiresAt: time.Now().Add(time.Hour),
+				Enabled: true, AuthStatus: account.AuthStatusActive, MaxConcurrent: 1,
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := modelRepo.UpsertDiscovered(ctx, account.ProviderBuild, []string{"grok-stream-finalization"}); err != nil {
+				t.Fatal(err)
+			}
+			if err := modelRepo.ReplaceAccountCapabilities(ctx, credential.ID, []string{"grok-stream-finalization"}, time.Now().UTC()); err != nil {
+				t.Fatal(err)
+			}
+			key, err := keyRepo.Create(ctx, clientkey.Key{
+				Name: "fixture-key", Prefix: "fixture-prefix", SecretHash: strings.Repeat("0", 64),
+				EncryptedSecret: "fixture-only", Enabled: true, RPMLimit: 120, MaxConcurrent: 8,
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			// The in-memory adapter returns a synthetic response; no account or
+			// token is sent to an external service by this test.
+			registry := provider.NewRegistry(&failoverAdapter{})
+			sticky := memory.NewStickyStore()
+			accountService := accountapp.NewService(accountRepo, auditRepo, memory.NewDeviceSessionStore(), sticky, registry, testCipher(t), nil)
+			clientService := clientkeyapp.NewService(nil, nil, nil, 60, 4, nil)
+			selector := NewSelector(accountRepo, memory.NewConcurrencyLimiter(), sticky, registry, time.Hour, time.Second, time.Minute)
+			service := NewService(modelRepo, auditRepo, accountService, clientService, registry, selector, responseRepo, 1)
+			requestCtx, cancel := context.WithCancel(ctx)
+			defer cancel()
+			result, err := service.CreateResponse(requestCtx, Input{
+				RequestID: "stream-finalization-fixture", ClientKey: key, PublicModel: "grok-stream-finalization",
+				Body: []byte(`{"model":"grok-stream-finalization","stream":true}`), Streaming: true,
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if test.canceled {
+				cancel()
+			}
+			// Stream close and handler completion can race. Account health and
+			// the audit must still be finalized only once.
+			var finished sync.WaitGroup
+			for i := 0; i < 8; i++ {
+				finished.Add(1)
+				go func() {
+					defer finished.Done()
+					result.Finalize(Usage{}, "", test.errorCode)
+				}()
+			}
+			finished.Wait()
+			_ = result.Body.Close()
+			observed, err := accountRepo.Get(ctx, credential.ID)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if test.canceled {
+				if observed.FailureCount != 0 || observed.CooldownUntil != nil || observed.LastError != "" {
+					t.Fatalf("client cancellation penalized account: failureCount=%d cooldown=%v lastError=%q", observed.FailureCount, observed.CooldownUntil, observed.LastError)
+				}
+			} else if observed.FailureCount != 1 || observed.CooldownUntil == nil || observed.LastError != "upstream status 502" {
+				t.Fatalf("upstream failure was not penalized once: failureCount=%d cooldown=%v lastError=%q", observed.FailureCount, observed.CooldownUntil, observed.LastError)
+			}
+			logs, total, err := auditRepo.List(ctx, 0, 10)
+			if err != nil || total != 1 || len(logs) != 1 || logs[0].ErrorCode != test.errorCode {
+				t.Fatalf("finalization audit count=%d logs=%#v err=%v", total, logs, err)
+			}
+		})
+	}
+}
