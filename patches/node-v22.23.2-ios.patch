diff --git a/deps/v8/src/common/code-memory-access.cc b/deps/v8/src/common/code-memory-access.cc
index 94328a128b80357e37705e585d1f0e2563317c74..fca32d713eb1d879634afc258724329ca895203e 100644
--- a/deps/v8/src/common/code-memory-access.cc
+++ b/deps/v8/src/common/code-memory-access.cc
@@ -8,6 +8,58 @@
 namespace v8 {
 namespace internal {
 
+#if defined(V8_OS_IOS)
+namespace {
+
+struct IosJitWriteState {
+  base::RecursiveMutex mutex;
+  size_t depth = 0;
+  std::vector<base::AddressRegion> writable_regions;
+};
+
+IosJitWriteState& GetIosJitWriteState() {
+  static IosJitWriteState* state = new IosJitWriteState;
+  return *state;
+}
+
+}  // namespace
+
+// iOS 16 does not provide MAP_JIT or pthread_jit_write_protect_np, but a
+// suitably entitled process can switch anonymous pages between RW and RX.
+// Serialize writers and restore executable permission when the outermost
+// write scope exits.
+void RwxMemoryWriteScope::SetWritable(Address address, size_t size) {
+  IosJitWriteState& state = GetIosJitWriteState();
+  state.mutex.Lock();
+  ++state.depth;
+  if (address == 0 || size == 0) return;
+
+  PageAllocator* allocator = GetPlatformPageAllocator();
+  const size_t page_size = allocator->CommitPageSize();
+  Address begin = RoundDown(address, page_size);
+  CHECK_LE(address, address + size);
+  Address end = RoundUp(address + size, page_size);
+  base::AddressRegion region{begin, end - begin};
+  CHECK(SetPermissions(allocator, region.begin(), region.size(),
+                       PageAllocator::kReadWrite));
+  state.writable_regions.push_back(region);
+}
+
+void RwxMemoryWriteScope::SetExecutable() {
+  IosJitWriteState& state = GetIosJitWriteState();
+  CHECK_GT(state.depth, 0);
+  if (--state.depth == 0) {
+    PageAllocator* allocator = GetPlatformPageAllocator();
+    for (base::AddressRegion region : state.writable_regions) {
+      CHECK(SetPermissions(allocator, region.begin(), region.size(),
+                           PageAllocator::kReadExecute));
+    }
+    state.writable_regions.clear();
+  }
+  state.mutex.Unlock();
+}
+#endif  // V8_OS_IOS
+
 ThreadIsolation::TrustedData ThreadIsolation::trusted_data_;
 
 #if V8_HAS_PTHREAD_JIT_WRITE_PROTECT || V8_HAS_PKU_JIT_WRITE_PROTECT
